# Authentication mode: local or oidc.
ALETHEUS_AUTH_MODE=local

# Local-development identity.
ALETHEUS_LOCAL_SUBJECT=local:jeremey
ALETHEUS_LOCAL_DISPLAY_NAME=Jeremey
ALETHEUS_LOCAL_ROLES=platform_architect
ALETHEUS_LOCAL_ENTITLEMENTS=runtime.read,providers.refresh,experience.preferences.write

# OIDC production configuration.
# ALETHEUS_AUTH_MODE=oidc
# ALETHEUS_ALLOW_LOCAL_IDENTITY=false
# ALETHEUS_OIDC_ISSUER=https://your-okta-domain/oauth2/default
# ALETHEUS_OIDC_AUDIENCE=api://aletheus
# ALETHEUS_OIDC_JWKS_URL=https://your-okta-domain/oauth2/default/v1/keys
# ALETHEUS_OIDC_ALGORITHMS=RS256
# ALETHEUS_OIDC_SUBJECT_CLAIM=sub
# ALETHEUS_OIDC_DISPLAY_NAME_CLAIM=name
# ALETHEUS_OIDC_ROLES_CLAIM=groups
# ALETHEUS_OIDC_ENTITLEMENTS_CLAIM=scp
# ALETHEUS_OIDC_CLOCK_SKEW_SECONDS=30
