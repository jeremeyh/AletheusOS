{
  "schema_version": "1.0",
  "licenses": {
    "allowed": [
      "0BSD",
      "Apache-2.0",
      "BSD",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "CC0-1.0",
      "ISC",
      "MIT",
      "MPL-2.0",
      "Python-2.0",
      "Unlicense"
    ],
    "review_required": [
      "LGPL-2.1",
      "LGPL-2.1-only",
      "LGPL-2.1-or-later",
      "LGPL-3.0",
      "LGPL-3.0-only",
      "LGPL-3.0-or-later",
      "unknown"
    ],
    "denied": [
      "AGPL-1.0",
      "AGPL-3.0",
      "AGPL-3.0-only",
      "AGPL-3.0-or-later",
      "SSPL-1.0"
    ]
  },
  "vulnerabilities": {
    "fail_on_severity": [
      "critical",
      "high"
    ],
    "warn_on_severity": [
      "moderate",
      "medium",
      "low"
    ],
    "maximum_accepted": {
      "critical": 0,
      "high": 0
    }
  },
  "manifest": {
    "maximum_age_hours": 168,
    "require_lockfile_hash_match": true,
    "require_package_manifest_hash_match": true
  }
}
