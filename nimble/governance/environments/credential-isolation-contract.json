{
  "schema_version": "1.0",
  "contract_id": "nimble-deployment-credential-isolation-v0.1",
  "policy": {
    "provider_binding_required": true,
    "environment_binding_required": true,
    "cross_environment_credentials_forbidden": true,
    "raw_secret_values_forbidden_in_evidence": true,
    "raw_secret_names_forbidden_in_public_evidence": true,
    "credential_fingerprints_required_in_execute_mode": true,
    "fingerprint_algorithm": "sha256",
    "fingerprint_truncation": 16,
    "fail_closed": true
  },
  "credential_declarations": {
    "source": "deployment-provider-registry.json",
    "field": "required_secrets",
    "scope": [
      "provider",
      "environment"
    ]
  },
  "evidence": {
    "credential_preflight": "reports/nimble/credential-isolation-latest.json",
    "public_fields": [
      "provider",
      "environment",
      "mode",
      "credential_count",
      "credential_fingerprints",
      "status",
      "failures"
    ]
  }
}
