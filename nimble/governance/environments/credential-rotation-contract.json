{
  "schema_version": "1.0",
  "contract_id": "nimble-credential-rotation-expiry-v0.1",
  "policy": {
    "rotation_required": true,
    "issued_at_required": true,
    "expires_at_required": true,
    "fingerprint_required": true,
    "stale_credentials_forbidden": true,
    "expired_credentials_forbidden": true,
    "revoked_credentials_forbidden": true,
    "future_issued_at_forbidden": true,
    "lineage_required_after_rotation": true,
    "raw_secret_values_forbidden": true,
    "fail_closed": true
  },
  "thresholds": {
    "default_max_age_days": 90,
    "warning_before_expiry_days": 14,
    "critical_before_expiry_days": 3,
    "clock_skew_tolerance_seconds": 300
  },
  "metadata": {
    "registry_path": "nimble/governance/environments/credential-metadata.json",
    "revocation_path": "nimble/governance/environments/credential-revocations.json"
  },
  "evidence": {
    "rotation_validation": "reports/nimble/credential-rotation-latest.json",
    "revocation_validation": "reports/nimble/credential-revocation-latest.json"
  }
}
