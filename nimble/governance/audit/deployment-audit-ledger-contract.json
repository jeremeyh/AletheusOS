{
  "schema_version": "1.0",
  "contract_id": "nimble-deployment-audit-ledger-v0.1",
  "ledger": {
    "path": "nimble/governance/audit/deployment-audit-ledger.jsonl",
    "format": "jsonl",
    "append_only": true,
    "hash_algorithm": "sha256",
    "genesis_previous_hash": "GENESIS"
  },
  "event_types": [
    "release_manifest_created",
    "promotion_validated",
    "deployment_started",
    "deployment_completed",
    "health_verified",
    "rollback_started",
    "rollback_completed",
    "credential_preflight",
    "credential_rotation_validated",
    "provider_preflight"
  ],
  "required_fields": [
    "sequence",
    "event_id",
    "event_type",
    "occurred_at",
    "actor",
    "environment",
    "release",
    "revision",
    "previous_hash",
    "event_hash"
  ],
  "policy": {
    "sequence_must_be_contiguous": true,
    "event_ids_must_be_unique": true,
    "timestamps_must_be_utc": true,
    "event_hash_required": true,
    "previous_hash_required": true,
    "tamper_detection_required": true,
    "raw_secret_values_forbidden": true,
    "raw_secret_names_forbidden": true,
    "absolute_paths_forbidden": true
  },
  "evidence": {
    "validation_report": "reports/nimble/deployment-audit-ledger-validation-latest.json",
    "summary_report": "reports/nimble/deployment-audit-ledger-summary-latest.json"
  }
}
