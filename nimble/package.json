{
  "name": "@aletheus/nimble-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Production workspace for the Nimble experience framework.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @aletheus/nimble-shell",
    "build": "npm run build --workspace @aletheus/nimble-shell",
    "preview": "npm run preview --workspace @aletheus/nimble-shell",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run typecheck && npm run test -- --run && npm run build",
    "production-gate": "../validate_nimble_production.sh",
    "production-evidence": "../.venv/bin/python ../collect_nimble_production_telemetry.py",
    "performance-baseline": "../.venv/bin/python ../create_nimble_performance_baseline.py",
    "performance-regression": "../.venv/bin/python ../validate_nimble_performance_regression.py",
    "baseline-governance": "../.venv/bin/python ../validate_nimble_baseline_governance.py",
    "validate-attestation": "../.venv/bin/python ../validate_nimble_release_attestation.py",
    "dependency-manifest": "../.venv/bin/python ../generate_nimble_dependency_manifest.py",
    "validate-dependencies": "../.venv/bin/python ../validate_nimble_dependency_manifest.py",
    "dependency-risk": "../.venv/bin/python ../scan_nimble_dependency_risk.py",
    "validate-dependency-risk": "../.venv/bin/python ../validate_nimble_dependency_risk.py",
    "validate-dependency-exceptions": "../.venv/bin/python ../validate_nimble_dependency_exceptions.py",
    "reconcile-dependency-exceptions": "../.venv/bin/python ../reconcile_nimble_dependency_exceptions.py",
    "ux:health": "npm run build && playwright test tests/ux/platform-health.spec.ts",
    "ux:health:update": "npm run build && playwright test tests/ux/platform-health.spec.ts --update-snapshots",
    "ux:report": "playwright show-report reports/ux/playwright"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1"
  }
}
