uniform float u_time; uniform float u_veracity; uniform float u_topologicalPhase; varying vec3 vNormal; varying vec3 vPosition; varying vec2 vUv; void main(){ vec3 nebular=mix(vec3(.42,.12,.95),vec3(0.,.85,1.),sin(u_time)*.5+.5); float ior=2.42; vec3 n=normalize(vNormal),v=normalize(-vPosition); vec3 crystal=vec3(length(refract(-v,n,1./(ior-.03))),length(refract(-v,n,1./ior)),length(refract(-v,n,1./(ior+.03)))); vec2 g=sin(vUv*50.+u_time); float p=step(.95,g.x)+step(.95,g.y); vec3 zk=vec3(0.,1.,.65)*p*u_topologicalPhase; gl_FragColor=vec4(mix(nebular,crystal+zk,u_topologicalPhase),mix(.4,.95,u_topologicalPhase)); }
