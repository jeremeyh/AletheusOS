{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LIGHTS Field Runtime State",
  "type": "object",
  "required": [
    "phase",
    "resonance",
    "respiration",
    "telemetry"
  ],
  "properties": {
    "phase": {
      "enum": [
        "Nebular",
        "Fluid Reactive",
        "Quasi-Crystalline",
        "Crystalline Solid"
      ]
    },
    "resonance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "respiration": {
      "type": "number",
      "minimum": 8,
      "maximum": 14
    },
    "telemetry": {
      "type": "object"
    }
  }
}
