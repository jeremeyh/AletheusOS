{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genesis 37.21 Package Manifest",
  "type": "object",
  "required": [
    "packageName",
    "version",
    "genesis",
    "runtimeModules",
    "applications"
  ],
  "properties": {
    "packageName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "genesis": {
      "const": "37.21"
    },
    "artifactState": {
      "type": "string"
    },
    "runtimeModules": {
      "type": "array"
    },
    "applications": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
